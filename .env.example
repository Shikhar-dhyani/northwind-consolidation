# Simple KEY=value configuration; process environment takes precedence.
# Copy to .env. Do not commit or paste your API key into a transcript.
ANTHROPIC_FOUNDRY_API_KEY=
ANTHROPIC_FOUNDRY_BASE_URL=https://YOUR-RESOURCE.services.ai.azure.com/anthropic/v1/messages
# Must match a Claude model deployed in your Foundry resource.
ANTHROPIC_FOUNDRY_MODEL=claude-sonnet-4-6
